<view class="container">
  <view class="header">
    <text class="page-title">设置</text>
  </view>

  <view class="content">
    <!-- 运动提醒 -->
    <view class="settings-section">
      <view class="section-header">
        <text class="section-title">运动提醒</text>
      </view>
      <view class="settings-item">
        <view class="settings-item-content">
          <text class="settings-label">每日提醒</text>
          <text class="settings-desc">设置每日运动提醒时间</text>
        </view>
        <switch 
          class="settings-switch"
          checked="{{reminderEnabled}}" 
          bindchange="toggleReminder"
          color="#4A90E2"
        />
      </view>
      <view class="settings-item" ty:if="{{reminderEnabled}}">
        <view class="settings-item-content">
          <text class="settings-label">提醒时间</text>
        </view>
        <picker 
          mode="time" 
          value="{{reminderTime}}" 
          bindchange="onReminderTimeChange"
        >
          <view class="picker-display">
            <text class="picker-value">{{reminderTime}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 闹钟功能 -->
    <view class="settings-section">
      <view class="section-header">
        <text class="section-title">闹钟</text>
        <text class="section-action" bindtap="addAlarm">+ 添加</text>
      </view>
      <view class="alarm-list">
        <view class="alarm-item" ty:for="{{alarms}}" ty:key="id" ty:for-item="alarm">
          <view class="alarm-content" bindtap="editAlarm" data-id="{{alarm.id}}">
            <view class="alarm-info">
              <text class="alarm-time">{{alarm.time}}</text>
              <text class="alarm-label">{{alarm.label}}</text>
              <text class="alarm-repeat">{{alarm.repeat.length}} 天重复</text>
            </view>
            <text class="alarm-arrow">›</text>
          </view>
          <switch 
            class="alarm-switch"
            checked="{{alarm.enabled}}" 
            bindchange="toggleAlarm"
            data-id="{{alarm.id}}"
            color="#4A90E2"
          />
        </view>
      </view>
    </view>

    <!-- FTMS蓝牙连接 -->
    <view class="settings-section">
      <view class="section-header">
        <text class="section-title">设备连接</text>
      </view>
      <view class="settings-item">
        <view class="settings-item-content">
          <text class="settings-label">FTMS蓝牙协议</text>
          <text class="settings-desc" ty:if="{{ftmsConnected}}">已连接: {{ftmsDeviceName}}</text>
          <text class="settings-desc" ty:else>连接健身器材设备</text>
        </view>
        <switch 
          class="settings-switch"
          checked="{{ftmsEnabled}}" 
          bindchange="toggleFTMS"
          color="#4A90E2"
        />
      </view>
    </view>
  </view>
</view>

