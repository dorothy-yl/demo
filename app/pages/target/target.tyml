<view class="container">
  <image class="background-image" src="../../assets/Sportsman .png" mode="aspectFill"></image>
  <view class="overlay"></view>
  <!-- Header -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <image class="back-icon" src="../../assets/icons/Vector.svg" />
    </view>
    <text class="header-title thin">Target pattern</text>
    <view class="header-placeholder"></view>
  </view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'distance' ? 'active' : ''}}" bindtap="switchTab" data-tab="distance">
      <text class="tab-text">Distance</text>
      <view class="tab-underline" ty:if="{{activeTab === 'distance'}}"></view>
    </view>
    <view class="tab-item {{activeTab === 'time' ? 'active' : ''}}" bindtap="switchTab" data-tab="time">
      <text class="tab-text">Time</text>
      <view class="tab-underline" ty:if="{{activeTab === 'time'}}"></view>
    </view>
    <view class="tab-item {{activeTab === 'calories' ? 'active' : ''}}" bindtap="switchTab" data-tab="calories">
      <text class="tab-text">Calories</text>
      <view class="tab-underline" ty:if="{{activeTab === 'calories'}}"></view>
    </view>
    <view class="tab-item {{activeTab === 'resistance' ? 'active' : ''}}" bindtap="switchTab" data-tab="resistance">
      <text class="tab-text">Resistance</text>
      <view class="tab-underline" ty:if="{{activeTab === 'resistance'}}"></view>
    </view>
  </view>

  <!-- Slider Container -->
  <view class="slider-container">
    <view class="slider-value-display">
      <text class="current-value">{{currentValue}}</text>
      <text class="current-unit">{{unitText}}</text>
    </view>
    
    <view class="slider-track-container" id="slider-track" bindtouchstart="onSliderTap">
      <view class="slider-track"></view>
      <view class="slider-fill" style="width: {{sliderPercentage}}%"></view>
      <view 
        class="slider-thumb" 
        style="left: {{sliderPercentage}}%"
        catchtouchstart="onSliderStart"
        catchtouchmove="onSliderMove"
        catchtouchend="onSliderEnd"
      >
        <view class="slider-thumb-dot"></view>
        <!-- Tooltip Bubble -->
        <view class="slider-tooltip {{isDragging ? 'show' : ''}}">
          <text class="tooltip-text">{{currentValue}}</text>
        </view>
      </view>
    </view>
    
    <view class="slider-labels">
      <text class="slider-label-min">{{minValue}}</text>
      <text class="slider-label-max">{{maxValue}}</text>
    </view>
  </view>

  <!-- Empty State Hint -->
  <view class="empty-hint {{showEmptyHint ? 'show' : ''}}">
    <text class="empty-hint-text">Please set target {{activeTab === 'calories' ? 'calories' : unitText}}</text>
  </view>

  <!-- Start Exercise Button -->
  <view class="footer">
    <button class="start-btn" bindtap="startExercise">Start Workout</button>
  </view>
</view>

