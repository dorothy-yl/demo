.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1D35 0%, #0A0E27 100%);
  padding: 0;
  padding-bottom: 80px;
  box-sizing: border-box;
  position: relative;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 20px;
  height: 44px;
  position: relative;
}

.time {
  font-size: 15px;
  font-weight: 600;
  color: #FFFFFF;
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
}

.status-icons {
  display: flex;
  align-items: center;
  gap: 6px;
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
}

.signal-icon {
  width: 18px;
  height: 12px;
  position: relative;
  display: flex;
  align-items: flex-end;
}

.signal-icon::before {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 3px;
  height: 3px;
  background: #FFFFFF;
  border-radius: 50%;
}

.signal-icon::after {
  content: '';
  position: absolute;
  right: 4px;
  bottom: 0;
  width: 2px;
  height: 5px;
  background: #FFFFFF;
}

.wifi-icon {
  width: 16px;
  height: 12px;
  position: relative;
}

.wifi-icon::before {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 12px;
  height: 8px;
  border: 2px solid #FFFFFF;
  border-top: none;
  border-radius: 0 0 12px 12px;
}

.battery-icon {
  width: 24px;
  height: 12px;
  border: 1.5px solid #FFFFFF;
  border-radius: 2px;
  position: relative;
  background: transparent;
}

.battery-icon::after {
  content: '';
  position: absolute;
  right: -4px;
  top: 50%;
  transform: translateY(-50%);
  width: 2px;
  height: 6px;
  background: #52C41A;
  border-radius: 0 1px 1px 0;
}

.battery-icon::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 8px;
  background: #52C41A;
  border-radius: 1px;
}

/* 页面标题和右上角操作 */
.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  padding: 12px 0 24px;
  margin-top: 20px;
}

.header-actions {
  position: absolute;
  top: 50px; /* Adjust based on status bar height */
  right: 20px;
  display: flex;
  gap: 10px;
  z-index: 10;
}

.action-btn {
  width: 30px;
  height: 30px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dots {
  display: flex;
  gap: 2px;
}

.dots::before, .dots::after {
  content: '';
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  display: block;
}
.dots {
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  position: relative;
}
.dots::before { position: absolute; left: -5px; }
.dots::after { position: absolute; right: -5px; }

.close-icon {
  color: #fff;
  font-size: 20px;
  line-height: 1;
}

/* 运动数据摘要区域 */
.exercise-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px 32px;
}

.summary-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-value {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin-bottom: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Try to match handwritten font style if possible, otherwise standard sans */
}

.summary-label {
  font-size: 18px;
  color: #B0B0B0;
  line-height: 1.4;
  margin-top: 4px;
}

.summary-right {
  flex-shrink: 0;
  margin-left: 20px;
}

/* 自行车圆形背景 */
.bicycle-circle-outer {
  width: 212px;
  height: 212px;
  border-radius: 50%;
  background:#2C3A4A;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.bicycle-circle-inner {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
}

.bicycle-image {
  width: 176px;
  height: 229px;
  top:89px;
  left:165px
  object-fit: contain;
}

/* 常用功能区域 */
.common-functions {
  padding: 0 20px 20px;
}

.section-title {
  font-size: 16px;
  color: #B0B0B0;
  margin-bottom: 20px;
  text-align: left;
  font-weight: 400;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 16px;
  background: #15192B;
  border-radius: 12px;
  /* box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2); */
}

.function-icon-wrapper {
  width: 48px;
  height: 48px;
  /* border-radius: 8px; */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  background: transparent !important; /* Remove background colors */
}

/* Icons need to be colored or have backgrounds in SVG. 
   The screenshot shows colored icons on dark background.
   Let's assume the SVGs are colored or we use filters/CSS to color them.
   Or maybe they are just images on dark background.
   Wait, the previous code had background colors for wrappers. 
   In the screenshot, the icons are just colored lines on dark background.
   Wait, the previous code had background colors:
   .function-icon-wrapper.quick-start { background: #FFB200; }
   This creates a colored square behind the icon.
   In the screenshot, the icons are floating, no colored square background.
   The icons themselves are colored (Yellow runner, Blue target, Blue monitor, Pink bulb).
*/
.function-icon-wrapper {
  background: none !important;
}

.function-icon {
  width: 30px;
  height: 30px;
  top:400px;
  left:46px;
}

.function-label {
  font-size: 14px;
  color: #FFFFFF;
  text-align: center;
  margin-top: 8px;
}

/* 连接状态 */
.connection-status {
  background: #000000;
  display: flex;
  align-items: center;
  padding: 12px 20px;
  margin-top: 10px;
  width: 100%;
  box-sizing: border-box;
  position: absolute;
  bottom: 60px; /* Height of bottom nav */
  left: 0;
}

.status-indicator {
  width: 12px;
  height: 12px;
  background-color: #00FF00;
  margin-right: 10px;
  border-radius: 2px;
}

.status-text {
  color: #FFFFFF;
  font-size: 14px;
  font-family: monospace; /* Matches screenshot somewhat */
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: #1A1D35;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 8px 0;
  border-top: 1px solid #2A2D45;
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.nav-icon {
  width: 28px;
  height: 28px;
}

.nav-item.active .nav-icon {
  /* opacity: 1; */
  /* filter: brightness(0) saturate(100%) invert(67%) sepia(95%) saturate(1352%) hue-rotate(75deg) brightness(95%) contrast(88%); */
  /* Assuming the active icon is green in screenshot */
  filter: drop-shadow(0 0 2px rgba(0, 255, 0, 0.5));
}

.nav-item:not(.active) .nav-icon {
  opacity: 0.5;
  /* filter: grayscale(100%) brightness(0.7); */
}
