.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg,#2C3A4A 0%,#2C3A4A 100%);
  padding: 0;
  padding-bottom: 80px;
  box-sizing: border-box;
  position: fixed;
  top:0;
  left:0;
  right:0;
}


/* 页面标题和右上角操作 */
.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  padding: 12px 0 24px;
  margin-top: 53px;
}

.header-actions {
  position: absolute;
  top: 50px; /* Adjust based on status bar height */
  right: 20px;
  display: flex;
  gap: 10px;
  z-index: 10;
}

.action-btn {
  width: 30px;
  height: 30px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dots {
  display: flex;
  gap: 2px;
}

.dots::before, .dots::after {
  content: '';
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  display: block;
}
.dots {
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  position: relative;
}
.dots::before { position: absolute; left: -5px; }
.dots::after { position: absolute; right: -5px; }

.close-icon {
  color: #fff;
  font-size: 20px;
  line-height: 1;
}

/* 运动数据摘要区域 */
.exercise-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px 40px;
}

.summary-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-value {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin-bottom: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Try to match handwritten font style if possible, otherwise standard sans */
}

.summary-label {
  font-size: 18px;
  color: #B0B0B0;
  line-height: 1.4;
  margin-top: 4px;
}

.summary-right {
  flex-shrink: 0;
  margin-left: 20px;
}

/* 自行车圆形背景 */
/* 外圆：改成透明背景 + 边框 */
.bicycle-circle-outer {
  width: 212px;
  height: 212px;
  border-radius: 50%;
  border: 0.5px solid rgba(144, 147, 174, 0.6); /*#2C3A4A 的RGBA值，透明度0.6 */
  background: transparent; /* 背景透明 */
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 内圆：保持现有样式即可（浅色实心圆） */
.bicycle-circle-inner {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
}
.bicycle-image {
  width: 176px;
  height: 229px;
  top:89px;
  left:165px
  object-fit: contain;
}

/* 常用功能区域 */
.common-functions {
  padding: 0 20px 20px;
}



.section-title {
  font-size: 19px;
  font-weight: 400;
  color: #9E9E9E;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px; /* Slightly tighter gap */
  margin-top:8px;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Align text to left */
  padding: 24px 20px;
  background: #151925; /* Darker background */
  border-radius: 40px 16px 16px 16px; /* Asymmetric border radius */
  position: relative;
  height: 140px; /* Fixed height for consistency */
  box-sizing: border-box;
  justify-content: space-between;
}

/* Specific background shapes for icon wrappers */
.function-icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 50%; /* Circle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
  background: #1E2430 !important; /* Slightly lighter than card bg */
}

.function-icon {
  width: 24px;
  height: 24px;
}

/* Icon Colors - Removed filters as per user request to use original icon colors */
/* Quick Start */
.function-item:nth-child(1) .function-icon {
  /* filter: invert(76%) sepia(68%) saturate(1688%) hue-rotate(359deg) brightness(101%) contrast(106%); */
}

/* Target pattern */
.function-item:nth-child(2) .function-icon {
  /* filter: invert(85%) sepia(25%) saturate(969%) hue-rotate(128deg) brightness(96%) contrast(98%); */
}

/* FTMS */
.function-item:nth-child(3) .function-icon {
  /* filter: invert(36%) sepia(61%) saturate(2465%) hue-rotate(200deg) brightness(100%) contrast(96%); */
}

/* Tirp */
.function-item:nth-child(4) .function-icon {
  /* filter: invert(56%) sepia(39%) saturate(3504%) hue-rotate(315deg) brightness(100%) contrast(96%); */
}


.function-label {
  font-size: 16px;
  font-weight: 500;
  color: #FFFFFF;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
}

/* 连接状态 */
.connection-status {
  background: #000000;
  display: flex;
  align-items: center;
  padding: 12px 20px;
  margin-top: 10px;
  width: 100%;
  box-sizing: border-box;
  position: absolute;
  bottom: 60px; /* Height of bottom nav */
  left: 0;
}

.status-indicator {
  width: 12px;
  height: 12px;
  background-color: #00FF00;
  margin-right: 10px;
  border-radius: 2px;
}

.status-text {
  color: #FFFFFF;
  font-size: 14px;
  font-family: monospace; /* Matches screenshot somewhat */
}

