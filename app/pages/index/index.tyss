.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg,#2C3A4A 0%,#2C3A4A 100%);
  padding: 0;
  padding-bottom: 80px;
  box-sizing: border-box;
}


/* 页面标题和右上角操作 */
.page-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  padding:0 0 24px;
  margin-top: 53px;
}

.header-actions {
  position: absolute;
  top: 50px; /* Adjust based on status bar height */
  right: 20px;
  display: flex;
  gap: 10px;
  z-index: 10;
}

.action-btn {
  width: 30px;
  height: 30px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dots {
  display: flex;
  gap: 2px;
}

.dots::before, .dots::after {
  content: '';
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  display: block;
}
.dots {
  width: 3px;
  height: 3px;
  background: #fff;
  border-radius: 50%;
  position: relative;
}
.dots::before { position: absolute; left: -5px; }
.dots::after { position: absolute; right: -5px; }

.close-icon {
  color: #fff;
  font-size: 20px;
  line-height: 1;
}

/* 运动数据摘要区域 */
.exercise-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px 25px;
}

.summary-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-value {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin-bottom: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Try to match handwritten font style if possible, otherwise standard sans */
}

.summary-label {
  font-size: 18px;
  color: #B0B0B0;
  line-height: 1.4;
  margin-top: 4px;
}

.summary-right {
  flex-shrink: 0;
  margin-left: 20px;
}

/* 自行车圆形背景 */
/* 外圆：改成透明背景 + 边框 */
.bicycle-circle-outer {
  width: 212px;
  height: 212px;
  border-radius: 50%;
  border: 0.5px solid rgba(144, 147, 174, 0.6); /*#2C3A4A 的RGBA值，透明度0.6 */
  background: transparent; /* 背景透明 */
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 内圆：保持现有样式即可（浅色实心圆） */
.bicycle-circle-inner {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
}
.bicycle-image {
  width: 176px;
  height: 229px;
  object-fit: contain;
  position: relative;
  margin-top: 20px;
}

/* 常用功能区域 */
/* 常用功能区域 */
.common-functions {
  padding: 0 20px 20px;
  box-sizing: border-box; /* 新增：防止padding撑大容器 */
}

.section-title {
  font-size: 19px;
  font-weight: 400;
  color: #9E9E9E;
}

.function-grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 2列均分 */
  margin-top: 18px;
  height: auto;
  gap: 12px;
  box-sizing: border-box;
  /* 移除justify-items: center，避免和item的对齐冲突 */
}

/* 统一所有item的基础样式，减少重复 */
.function-item1, .function-item2, .function-item3, .function-item4 {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #151925;
  position: relative;
  box-sizing: border-box;
  justify-content: space-around;
  padding: 16px 0 0 16px;
  /* 统一高度，避免不同item高度不一致 */
  height: 160px;
  /* 移除硬编码的left/width/justify-self，改用Grid自适应 */
  width: 100%; /* 占满Grid列宽 */
  max-width: 180px; /* 限制最大宽度，避免大屏拉伸 */
}

/* 单独保留每个item的圆角设计（修复你原有的语法错误：30 → 30px） */
.function-item1 {
  border-radius: 30px 0 0 0;
}

.function-item2 {
  border-radius: 30px 0 30px 30px; /* 原代码少了px，已修复 */
}

.function-item3 {
  border-radius: 30px 30px 30px 0;
}

.function-item4 {
  border-radius: 0 0 30px 0;
}

/* Specific background shapes for icon wrappers */
.function-icon-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 50%; /* Circle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
  background: #1E2430 !important; /* Slightly lighter than card bg */
}

/* 兼容不同icon的自定义样式（你原代码里的target-pattern/ftms/tirp） */
.function-icon-wrapper.target-pattern,
.function-icon-wrapper.ftms,
.function-icon-wrapper.tirp {
  /* 如需单独样式可在这里加，保持和原逻辑一致 */
  background: #1E2430 !important;
}

.function-icon {
  width: 30px;
  height: 30px;
}

.function-label {
  font-size: 20px;
  font-weight: 500;
  color: #FFFFFF;
  text-align: left;
  margin-top: 0;
  line-height: 1.2;
}
/* 连接状态 */
.connection-status {
  background: #000000;
  display: flex;
  align-items: center;
  padding: 12px 20px;
  margin-top: 10px;
  width: 100%;
  box-sizing: border-box;
  position: absolute;
  bottom: 60px; /* Height of bottom nav */
  left: 0;
}

.status-indicator {
  width: 12px;
  height: 12px;
  background-color: #00FF00;
  margin-right: 10px;
  border-radius: 2px;
}

.status-text {
  color: #FFFFFF;
  font-size: 14px;
  font-family: monospace; /* Matches screenshot somewhat */
}

