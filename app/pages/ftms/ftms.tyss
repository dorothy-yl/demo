.container {
  display: flex;
  flex-direction: column;
  background-color: #2C3A4A;
  min-height: 100vh;
  padding: 20px;
  box-sizing: border-box;
  align-items: center;
}

.header {
  width: 100%;
  display: flex;
  justify-content: center;
  padding-top: 0;
  margin-bottom: 20px;
  position: relative;
  height: 88px; /* Ensure enough height */
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-title {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 500;
  margin-top: 53px;
}

.icon-section {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 200px;
  margin-bottom: 40px;
  gap: 40px;
}

.device-icon {
  width: 80px;
  height: 80px;
}

.dots-container {
  display: flex;
  gap: 16px;
  align-items: center;
}

.dot {
  width: 10px;
  height: 10px;
  background-color: #FFFFFF;
  border-radius: 50%;
  opacity: 0;
  animation: dotFade 1.5s infinite;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.5s; }
.dot:nth-child(3) { animation-delay: 1s; }

@keyframes dotFade {
  0% { opacity: 0.3; }
  50% { opacity: 1; }
  100% { opacity: 0.3; }
}

.controls-wrapper {
  width: 100%;
  margin-bottom: 60px;
}

.control-row {
  background-color: #2B3240;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.control-label {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 400;
}

.slider-card {
  background-color: #2B3240;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
}

.slider-value {
  color: #FFFFFF;
  font-size: 32px;
  font-weight: 500;
  margin-bottom: 24px;
}

.slider-body {
  width: 100%;
  margin-bottom: 12px;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  color: #FFFFFF;
  font-size: 14px;
  opacity: 0.8;
}

