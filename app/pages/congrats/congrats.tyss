.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: #2C3A4A;
  font-family: sans-serif;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  height: 100%;
  box-sizing: border-box;
}

.page-title {
  color: #ffffff;
  font-size: 48rpx;
  margin-top: 100rpx;
  margin-bottom: 40rpx;
  font-weight: normal;
  font-family: sans-serif;
}

.top-card {
  background-color: rgba(0, 0, 0, 0.2);
  width: 344px;
  height: 246px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 0;
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  z-index: 10;
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #d8d8d8; /* Placeholder gray */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-icon {
  width: 48rpx;
  height: 48rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.date {
  color: #a0a4b0;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.main-circle-section {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  margin: 160rpx auto 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-ring-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.ring-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx; /* Adjust to center visually within the arc */
}

.ring-value-row {
  display: flex;
  align-items: baseline;
}

.ring-value {
  color: #ffffff;
  font-size: 96rpx;
  font-weight: bold;
}

.ring-unit {
  color: #a0a4b0;
  font-size: 28rpx;
  margin-left: 8rpx;
}

.ring-label {
  color: #D3D3D3;
  font-size: 15px;
  margin-top: 24px;
}


.stats-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stats-card {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.wide-card {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  color: #a0a4b0;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.vertical-line {
  width: 2rpx;
  height: 60rpx;
  background-color: #4a4e60;
}

.bottom-grid {
  display: flex;
  gap: 24rpx;
}

.big-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 240rpx;
}

.right-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.small-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.card-title {
  color: #a0a4b0;
  font-size: 14px;
  font-family: sans-serif;
}

.card-icon {
  width: 40rpx;
  height: 40rpx;
  margin-top: 16rpx;
}
.card-icon-small {
  width: 32rpx;
  height: 32rpx;
  margin-top: 12rpx;
  opacity: 0.8;
}

.big-value-row {
  margin-top: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end; /* Align right like screenshot */
}

.small-value-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.big-value {
  color: #ffffff;
  font-size: 86rpx;
  font-weight: bold;
}

.medium-value {
  color: #ffffff;
  font-size: 54rpx;
  font-weight: bold;
}

.unit {
  color: #a0a4b0;
  font-size: 24rpx;
  margin-left: 8rpx;
}
