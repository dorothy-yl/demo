<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <image class="back-icon" src="../../assets/icons/Vector.svg" />
    </view>
    <text class="header-title">{{pageTitle}}</text>
    <view class="header-placeholder"></view>
  </view>

  <!-- Speed and Heart Rate Row -->
  <view class="top-row">
    <view class="top-stat-item">
      <text class="top-stat-value">{{speed}}</text>
      <text class="top-stat-label">{{I18n.t('speed_kmh')}}</text>
    </view>
    <view class="vertical-divider"></view>
    <view class="top-stat-item">
      <view class="value-icon-row">
        <text class="top-stat-value">{{calories}}</text>
        <image class="heart-icon" src="../../assets/icons/Vector 2.svg" />
      </view>
      <text class="top-stat-label">{{I18n.t('calories_kcal')}}</text>
    </view>
  </view>

  <!-- Exercise Time Card -->
  <view class="card timer-card">
    <text class="card-label">{{I18n.t('workout_time')}}</text>
    <text class="timer-display">{{formattedTime}}</text>
  </view>

  <!-- 3-Column Stats Grid -->
  <view class="stats-grid">
    <view class="card stat-card">
      <text class="card-label">{{I18n.t('rpm')}}</text>
      <text class="card-value">{{rpm}}</text>
    </view>
    <view class="card stat-card">
      <text class="card-label">{{I18n.t('hr_bpm')}}</text>
      <text class="card-value">{{heartRate}}</text>
    </view>
    <view class="card stat-card">
      <text class="card-label">{{I18n.t('power_w')}}</text>
      <text class="card-value">{{watt}}</text>
    </view>
  </view>

  <!-- Distance Card -->
  <view class="card timer-card">
    <text class="card-label">{{I18n.t('distance_km')}}</text>
    <text class="timer-display">{{distance}}</text>
  </view>


  <!-- Load Gauge Section -->
  <view class="gauge-section">
    <view class="gauge-wrapper" catchtouchmove="handleTouchMove" catchtouchstart="handleTouchMove" catchtouchend="handleTouchEnd">
      <!-- Background Arc -->
      <view class="gauge-background"></view>
      <!-- Progress Arc (Dynamic) -->
      <view class="gauge-progress" style="{{gaugeProgressStyle}}"></view>
      <!-- Center Text -->
      <view class="gauge-center-cover">
        <text class="gauge-center-value">{{load}}</text>
        <text class="gauge-center-label">{{I18n.t('load')}}</text>
      </view>
      <!-- Gauge Knob -->
      <view class="gauge-knob-container" style="transform: rotate({{knobAngle}}deg);">
         <view class="gauge-knob"></view>
      </view>
    </view>
    <view class="gauge-labels">
      <text>0</text>
      <text>32</text>
    </view>
  </view>

  <!-- Bottom Button -->
  <view class="footer">
    <button class="main-action-btn" bindlongpress="stopExercise" bindtap="togglePause">{{I18n.t('start_hold_stop')}}</button>
  </view>
</view>
