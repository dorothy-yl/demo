.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #0A0E27 0%, #1A1D35 100%);
  padding: 0;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
  position: relative;
  padding: 0 20px;
  height: 88px;
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 4px;
  margin-top: 53px;
}

.page-subtitle {
  font-size: 16px;
  color: #8E8E93;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 0 20px 20px 20px;
}

.main-card {
  background: #1A1D35;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.main-card-left {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.duration-value {
  font-size: 32px;
  font-weight: bold;
  color: #FFFFFF;
}

.duration-unit {
  font-size: 16px;
  color: #8E8E93;
}

.main-card-right {
  align-self: flex-end;
}

.record-date-time {
  font-size: 14px;
  color: #8E8E93;
}

.main-card-stats {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 12px;
  color: #8E8E93;
  margin-bottom: 4px;
}

.stat-value {
  font-size: 16px;
  font-weight: bold;
  color: #FFFFFF;
}

.stat-divider {
  width: 1px;
  height: 30px;
  background: #2A2D45;
}

.cards-row {
  display: flex;
  gap: 12px;
}

.card-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.info-card {
  background: #1A1D35;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100px;
  justify-content: center;
}

.card-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 8px;
}

.card-icon image {
  width: 100%;
  height: 100%;
}

.card-label {
  font-size: 12px;
  color: #8E8E93;
  margin-bottom: 8px;
  text-align: center;
}

.card-value {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
  text-align: center;
}

.bottom-card {
  background: #1A1D35;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bottom-card .card-label {
  font-size: 14px;
  color: #8E8E93;
  margin-bottom: 12px;
}

.bottom-card .card-value {
  font-size: 24px;
  font-weight: bold;
  color: #FFFFFF;
}

