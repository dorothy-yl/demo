.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg,#2C3A4A  0%,#2C3A4A 100%);
  padding: 0;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
  position: relative;
  padding: 0 20px;
  height: 88px;
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 25px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 4px;
  margin-top: 53px;
}

.page-subtitle {
  font-size: 16px;
  color: #8E8E93;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 0 20px 20px 20px;
}

/* 顶部卡片（与 history 页面一致） */
.top-card {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.duration-group {
  display: flex;
  align-items: baseline;
}

.duration-val {
  font-size: 20px;
  font-weight: 400;
  color: #FFFFFF;
}

.record-date {
  font-size: 15px;
  color: #B0B0B0;
}

.card-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 15px;
  color: #B0B0B0;
  margin-bottom: 8px;
}

.stat-val {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.stat-divider {
  width: 1px;
  height: 24px;
  background: rgba(255, 255, 255, 0.2);
}

/* Speed、Calories、Distance 卡片布局 */
.middle-cards-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
}

.speed-card {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  position: relative;
  flex: 1;
  height: 80px;
  box-sizing: border-box;
}

.right-cards-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.info-card {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  position: relative;
  height: 80px;
  box-sizing: border-box;
}

.card-label {
  font-size: 15px;
  color: #8E8E93;
  margin-bottom: 8px;
  text-align: left;
}

.card-icon {
  width: 24px;
  height: 24px;
  margin-bottom: auto;
}

.speed-card .card-icon {
  margin-bottom: 0;
  margin-top: 4px;
}

.card-icon image {
  width: 100%;
  height: 100%;
}

.card-value-wrapper {
  position: absolute;
  bottom: 16px;
  right: 16px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.speed-card .card-value-wrapper {
  bottom: 12px;
}

.card-value {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
  text-align: right;
  line-height: 1;
}

/* 底部三个卡片 */
.bottom-cards {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.bottom-card-item {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.bottom-card-label {
  font-size: 15px;
  color: #8E8E93;
}

.bottom-card-value {
  font-size: 24px;
  font-weight: bold;
  color: #FFFFFF;
}

