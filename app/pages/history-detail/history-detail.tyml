<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <image class="back-icon" src="../../assets/icons/Vector.svg" mode="aspectFit"></image>
    </view>
    <view class="header-title">
      <text class="page-title">Details</text>
      <text class="page-subtitle">Quick Start</text>
    </view>
  </view>

  <view class="content" ty:if="{{record}}">
    <!-- 主要信息卡片 -->
    <view class="main-card">
      <view class="main-card-left">
        <text class="duration-value">{{record.duration}}</text>
      </view>
      <view class="main-card-right">
        <text class="record-date-time">{{record.date}}</text>
      </view>
      <view class="main-card-stats">
        <view class="stat-item">
          <text class="stat-label">Speed(km/h)</text>
          <text class="stat-value">{{record.speed}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-label">RPM</text>
          <text class="stat-value">{{record.rpm || '52'}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-label">Watt</text>
          <text class="stat-value">{{record.watt || '50.1'}}</text>
        </view>
      </view>
    </view>

    <!-- 两列卡片 -->
    <view class="cards-row">
      <view class="card-column">
        <view class="info-card">
          <view class="card-icon green">
            <image src="../../assets/icons/Target patterm.svg" mode="aspectFit"></image>
          </view>
          <text class="card-label">Maximum resistance</text>
          <text class="card-value">{{record.maxResistance || '19'}}</text>
        </view>
        <view class="info-card">
          <text class="card-label">Heart rate</text>
          <text class="card-value">{{record.heartRate || '60'}}</text>
        </view>
      </view>
      <view class="card-column">
        <view class="info-card">
          <view class="card-icon orange">
            <image src="../../assets/icons/love.svg" mode="aspectFit"></image>
          </view>
          <text class="card-label">Calories</text>
          <text class="card-value">{{record.calories}} kcal</text>
        </view>
        <view class="info-card">
          <view class="card-icon blue">
            <image src="../../assets/icons/Trip.svg" mode="aspectFit"></image>
          </view>
          <text class="card-label">Distance</text>
          <text class="card-value">{{record.distance}} km</text>
        </view>
      </view>
    </view>

    <!-- 底部卡片 -->
    <view class="bottom-card">
      <text class="card-label">Minimum resistance</text>
      <text class="card-value">{{record.minResistance || '1.3'}}</text>
    </view>
  </view>
</view>

