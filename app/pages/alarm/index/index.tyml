<view class="container">
  <!-- Custom Header -->
  <view class="custom-header">
    <view class="header-left" bindtap="onBack">
      <image class="back-icon" src="../../assets/icons/Vector.svg" />
    </view>
    <text class="header-title">Tirp</text>
    <view class="header-right"></view>
  </view>

  <!-- Content Wrapper to offset header -->
  <view class="content-wrapper">
    <!-- Empty State Text - Left Bottom -->
    <view class="empty-state-text" ty:if="{{!hasAlarms}}">
      <text class="empty-title">Exercise reminder</text>
      <text class="empty-desc">Click "Add" in the upper right corner.</text>
    </view>

    <!-- Calendar in Center -->
    <view class="calendar-container">
      <!-- Month Navigation -->
      <view class="month-header">
        <view class="month-nav-btn" bindtap="prevMonth">
          <text class="nav-arrow">‹</text>
        </view>
        <text class="month-title">{{currentMonthText}}</text>
        <view class="month-nav-btn" bindtap="nextMonth">
          <text class="nav-arrow">›</text>
        </view>
      </view>

      <!-- Weekday Headers -->
      <view class="weekday-headers">
        <view class="weekday-header" ty:for="{{weekdays}}" ty:key="*this">
          <text class="weekday-text">{{item}}</text>
        </view>
      </view>

      <!-- Calendar Grid -->
      <view class="calendar-grid">
        <view 
          class="calendar-day {{item.isCurrentMonth ? '' : 'other-month'}} {{item.hasSettings ? 'has-settings' : ''}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
          ty:for="{{calendarDays}}" 
          ty:key="date"
          bindtap="selectDate"
          data-date="{{item.date}}"
        >
          <text class="day-number">{{item.day}}</text>
          <view class="settings-indicator" ty:if="{{item.hasSettings}}"></view>
        </view>
      </view>
    </view>

    <!-- Alarm List -->
    <scroll-view scroll-y="true" class="alarm-list" ty:if="{{hasAlarms}}">
      <view class="alarm-section-title">其他</view>
      
      <view class="alarm-item" ty:for="{{alarms}}" ty:key="id">
        <view class="alarm-content">
          <view class="alarm-time-row">
            <text class="alarm-time">{{item.timeStr}}</text>
            <text class="alarm-tag">{{item.tag || '闹钟'}}</text>
          </view>
          <text class="alarm-repeat">{{item.repeatStr}}</text>
        </view>
        
        <view class="alarm-actions">
          <switch checked="{{item.enabled}}" bindchange="onToggleAlarm" data-id="{{item.id}}" color="#52C41A"/>
          <!-- Delete button simulation for swipe or direct delete -->
          <view class="delete-btn" bindtap="onDelete" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Add Button - Right Bottom -->
  <view class="add-button-container" bindtap="onAdd">
    <view class="add-button-circle">
      <text class="add-icon">+</text>
    </view>
  </view>

  <bottom-nav activeTab="clock" />
</view>
