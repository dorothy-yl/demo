.container {
  background-color:#2C3A4A;
  min-height: 100vh;
  color: #fff;
}

.custom-header {
  position: fixed;
  margin-top:70px;
  left: 0;
  width: 100%;
  height: 88px; 
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  background-color:#2C3A4A
  z-index: 100;
  box-sizing: border-box;
}

.header-left {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  position: static;
  top: auto;
  left: auto;
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-center {
  flex: 1; /* 占满左右元素剩余空间 */
  text-align: center;
}

.header-title {
 font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  padding: 0;
  margin: 0;
}


.header-right {
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 0;
}

.add-icon {
  font-size: 30px;
  color: #52C41A; /* Green color */
  font-weight: bold;
}

.content-wrapper {
  padding-top: 88px; /* Push content down */
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 70vh; /* Adjusted for header */
}

.empty-content {
  text-align: center;
}

.empty-title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 10px;
  display: block;
}

.empty-desc {
  font-size: 16px;
  color: #8E8E93;
}

.alarm-list {
  padding: 20px;
}

.alarm-section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
  color: #fff;
}

.alarm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.alarm-time-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 5px;
}

.alarm-time {
  font-size: 40px;
  font-weight: 300;
  margin-right: 10px;
}

.alarm-tag {
  font-size: 14px;
  color: #8E8E93;
}

.alarm-repeat {
  font-size: 14px;
  color: #8E8E93;
  display: block;
}

.alarm-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  background-color: #FF4D4F;
  color: white;
  padding: 5px 10px;
  border-radius: 4px;
  margin-left: 10px;
  font-size: 14px;
}
