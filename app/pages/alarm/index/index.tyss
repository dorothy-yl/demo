.container {
  background-color: #2C3A4A;
  min-height: 100vh;
  color: #fff;
  padding-bottom: 120px; /* 为固定按钮留出空间 */
}

.custom-header {
  position: fixed;
  margin-top: 70px;
  left: 0;
  width: 100%;
  height: 88px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  background-color: #2C3A4A;
  z-index: 100;
  box-sizing: border-box;
}

.header-left {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.header-right {
  width: auto;
  min-width: 80px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.delete-text {
  font-size: 16px;
  color: #FFFFFF;
  cursor: pointer;
}

.delete-text:active {
  opacity: 0.7;
}

.schedule-link {
  font-size: 16px;
  color: #52C41A;
  cursor: pointer;
}

.schedule-link.active {
  color: #52C41A;
  font-weight: 600;
}

.schedule-link:active {
  opacity: 0.7;
}

.content-wrapper {
  padding-top: 158px;
  padding-bottom: 20px;
  min-height: calc(100vh - 158px);
  box-sizing: border-box;
}

/* Tips 标签页样式 */
.tips-content {
  width: 100%;
  height: calc(100vh - 158px);
  display: flex;
  flex-direction: column;
}

.tips-scroll-view {
  width: 100%;
  height: 100%;
  padding: 20px 16px;
  box-sizing: border-box;
}

.form-item-wrapper {
  position: relative;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  cursor: pointer;
}

.form-label {
  font-size: 16px;
  color: #FFFFFF;
}

.form-value {
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-icon {
  width: 16px;
  height: 16px;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 16px;
  color: #FFFFFF;
  background: transparent;
  border: none;
  outline: none;
}

.form-value-text {
  font-size: 16px;
  color: #8E8E93;
}

.form-value-text.selected {
  color: #52C41A;
}

/* 内联日期选择器 */
.inline-date-picker {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  background-color: #2C3A4A;
}

.inline-date-picker.expanded {
  max-height: 400px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  overflow-y: visible;
}

/* 日历月份导航 */
.calendar-month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  margin-bottom: 15px;
}

.calendar-month-nav-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
  cursor: pointer;
}

.calendar-nav-arrow {
  font-size: 24px;
  color: #FFFFFF;
  font-weight: bold;
  line-height: 1;
}

.calendar-month-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

/* 星期标题行 */
.calendar-weekday-headers {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 10px;
  gap: 4px;
}

.calendar-weekday-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 0;
}

.calendar-weekday-text {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 500;
}

/* 日期网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
  position: relative;
  min-height: 40px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
  cursor: pointer;
}

.calendar-day.other-month {
  opacity: 0.3;
}

.calendar-day.today {
  background-color: rgba(82, 196, 26, 0.15);
}

.calendar-day.selected {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.3);
}

.calendar-day.selected.today {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.4);
}

.calendar-day-number {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 500;
}

/* 内联时间选择器 */
.inline-time-picker {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  background-color: #2C3A4A;
}

.inline-time-picker.expanded {
  max-height: 300px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.time-picker-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  height: 200px;
  position: relative;
}

.time-picker-view {
  width: 100%;
  height: 200px;
}

.time-picker-item {
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 40px;
}

.time-picker-text {
  font-size: 18px;
  color: #8E8E93;
  transition: all 0.2s;
}

.time-picker-display {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10px 0;
}

.time-picker-display-text {
  font-size: 20px;
  color: #52C41A;
  font-weight: 600;
}

/* 固定底部按钮 */
.sure-button-fixed {
  position: fixed;
  bottom: 90px; /* 与底部导航栏位置一致 (30px + 60px) */
  left: 16px;
  right: 16px;
  height: 48px;
  background-color: #52C41A;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 0.2s;
  z-index: 99;
}

.sure-button-fixed:active {
  opacity: 0.8;
}

.sure-button-text {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 600;
}

/* 我的日程标签页样式 */
.schedule-content {
  width: 100%;
  height: calc(100vh - 158px);
}

.schedule-list {
  width: 100%;
  height: 100%;
  padding: 0 16px;
}

.schedule-item {
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  cursor: pointer;
}

.schedule-item:active {
  opacity: 0.7;
}

.schedule-title {
  display: block;
  font-size: 16px;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.schedule-datetime {
  display: block;
  font-size: 14px;
  color: #8E8E93;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 20px;
  min-height: 200px;
}

.empty-text {
  font-size: 16px;
  color: #8E8E93;
  text-align: center;
}
