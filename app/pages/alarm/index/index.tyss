.container {
  background-color:#2C3A4A;
  min-height: 100vh;
  color: #fff;
}

.custom-header {
  position: fixed;
  margin-top:70px;
  left: 0;
  width: 100%;
  height: 88px; 
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  background-color:#2C3A4A;
  z-index: 100;
  box-sizing: border-box;
}

.header-left {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  position: static;
  top: auto;
  left: auto;
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-center {
  flex: 1; /* 占满左右元素剩余空间 */
  text-align: center;
}

.header-title {
 font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  padding: 0;
  margin: 0;
}


.header-right {
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 0;
}

.add-icon {
  font-size: 30px;
  color: #52C41A; /* Green color */
  font-weight: bold;
}

.content-wrapper {
  padding-top: 134px; /* Push content down */
  position: relative;
  min-height: calc(100vh - 88px);
}

/* Empty State Text - Left Bottom */
.empty-state-text {
  position: absolute;
  left: 38px;
  bottom: 60px;
  z-index: 10;
}

.empty-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 6px;
  display: block;
  color: #FFFFFF;
}

.empty-desc {
  font-size: 13px;
  color: #8E8E93;
  display: block;
  line-height: 1.4;
}

/* Calendar Container - Center */
.calendar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 20px 16px;
  padding-top: 30px;
  min-height: calc(100vh - 200px);
  width: 100%;
}

/* Month Header */
.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 16px;
  width: 100%;
  box-sizing: border-box;
}

.month-nav-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
}

.nav-arrow {
  font-size: 24px;
  color: #FFA500;
  font-weight: bold;
}

.month-title {
  font-size: 20px;
  font-weight: 600;
  color: #FFFFFF;
}

/* Weekday Headers */
.weekday-headers {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 0 16px;
  margin-bottom: 10px;
  width: 100%;
  box-sizing: border-box;
}

.weekday-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 0;
}

.weekday-text {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 500;
}

/* Calendar Grid */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  padding: 0 16px;
  box-sizing: border-box;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
  position: relative;
  min-height: 44px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.calendar-day.other-month {
  opacity: 0.3;
}

.calendar-day.today {
}

.calendar-day.has-settings {
  background-color: rgba(82, 196, 26, 0.15);
}

.calendar-day.has-settings.today {
  background-color: rgba(82, 196, 26, 0.3);
}

.calendar-day.selected {
  border: 2px solid #52C41A;
  background-color: rgba(255, 255, 255, 0.05);
}

.calendar-day.selected.today {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.35);
}

.day-number {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 500;
}

.settings-indicator {
  position: absolute;
  bottom: 4px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #52C41A;
}

/* Add Button - Right Bottom */
.add-button-container {
  position: fixed;
  right: 40px;
  bottom: 123px;
  z-index: 100;
}

.add-button-circle {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.add-icon {
  font-size: 28px;
  color: #52C41A;
  font-weight: bold;
  line-height: 1;
}

.alarm-list {
  padding: 20px;
  margin-top: 20px;
}

.alarm-section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
  color: #fff;
}

.alarm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.alarm-time-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 5px;
}

.alarm-time {
  font-size: 40px;
  font-weight: 300;
  margin-right: 10px;
}

.alarm-tag {
  font-size: 14px;
  color: #8E8E93;
}

.alarm-repeat {
  font-size: 14px;
  color: #8E8E93;
  display: block;
}

.alarm-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  background-color: #FF4D4F;
  color: white;
  padding: 5px 10px;
  border-radius: 4px;
  margin-left: 10px;
  font-size: 14px;
}
