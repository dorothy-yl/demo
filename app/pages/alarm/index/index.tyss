.container {
  background-color: #2C3A4A;
  height: 100vh;
  width:100vw;
  color: #fff;
  padding-bottom: 120px; /* 为固定按钮留出空间 */
}

.custom-header {
  position: fixed;
  margin-top: 50px;
  left: 0;
  width: 100%;
  height: 88px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  background-color: #2C3A4A;
  z-index: 100;
  box-sizing: border-box;
}

.header-left {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 9px;
  height: 18px;
}

.header-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.header-right {
  width: auto;
  min-width: 80px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.delete-text {
  font-size: 16px;
  color: #FFFFFF;
  cursor: pointer;
}

.delete-text:active {
  opacity: 0.7;
}

.schedule-link {
  font-size: 16px;
  color:  #A2E525;
  cursor: pointer;
}

.schedule-link.active {
  color: #A2E525;
  font-weight: 600;
}

.schedule-link:active {
  opacity: 0.7;
}

.content-wrapper {
  padding-top: 120px;
  padding-bottom: 20px;
  min-height: calc(100vh - 158px);
  box-sizing: border-box;
}

/* Tips 标签页样式 */
.tips-content {
  width: 100%;
  height: calc(100vh - 158px);
  display: flex;
  flex-direction: column;
}

.tips-scroll-view {
  width: 100%;
  height: 100%;
  padding: 20px 23px; /* 左右padding改为23px，与设计稿一致 */
  box-sizing: border-box;
}

.form-item-wrapper {
  position: relative;
  
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  cursor: pointer;
}

/* 长方形输入框样式 */
.form-item-rect {
  width: 329px;
  height: 54px;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  margin-bottom: 16px;
  box-sizing: border-box;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

/* 当选择器展开时，移除间隙 */
.form-item-wrapper.picker-expanded .form-item-rect {
  margin-bottom: 0;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.form-item-rect:active {
  background-color: rgba(255, 255, 255, 0.15);
}

.form-input-rect {
  flex: 1;
  font-size: 18px;
  color: #9E9E9E !important;
  background: transparent;
  border: none;
  outline: none;
}

.form-input-rect::placeholder {
color: #9E9E9E;
 opacity: 1;
}

.form-icon-left {
  width: 24px;
  height: 24.06px;
  margin-right: 8px;
}

.form-label-rect {
  font-size: 18px;
  color: #FFFFFF;
  margin-right: auto;
}

.form-value-text-rect {
  font-size: 18px;
  color: #8E8E93;
  margin-left: auto;
    white-space: nowrap;

}

.form-value-text-rect.selected {
  color: #A2E525;
;
}

.form-label {
  font-size: 16px;
  color: #FFFFFF;
}

.form-value {
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-icon {
  width: 16px;
  height: 16px;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 16px;
  color: #FFFFFF;
  background: transparent;
  border: none;
  outline: none;
}

.form-value-text {
  font-size: 16px;
  color: #8E8E93;
}

.form-value-text.selected {
  color: #A2E525;
}

/* 内联日期选择器 */
.inline-date-picker {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
}

.inline-date-picker.expanded {
  max-height: 400px;
  padding-bottom: 16px;
  overflow-y: visible;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  padding-top: 8px;
  margin-bottom: 16px;
}

/* 年份和月份显示行 */
.calendar-year-month-header {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.calendar-year-month-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.calendar-year-month-text {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.calendar-year-select-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.calendar-year-arrow {
  font-size: 20px;
  color: #FFFFFF;
  font-weight: bold;
  line-height: 1;
}

/* 内联月份切换导航 */
.calendar-month-nav-inline {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* 月份切换导航（保留以防其他地方使用） */
.calendar-month-nav {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 10px 0;
}

.calendar-month-nav-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
  cursor: pointer;
}

.calendar-nav-arrow {
  font-size: 24px;
  color: #FFFFFF;
  font-weight: bold;
  line-height: 1;
}

/* 星期标题行 */
.calendar-weekday-headers {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 10px;
  gap: 4px;
}

.calendar-weekday-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 0;
}

.calendar-weekday-text {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 500;
}

/* 日期网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  position: relative;
  min-height: 40px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
  cursor: pointer;
}

.calendar-day.empty {
  background-color: transparent;
  cursor: default;
  pointer-events: none;
}

.calendar-day.today {
  border: 2px solid rgba(82, 196, 26, 0.5);
}

.calendar-day.selected {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.2);
}

.calendar-day.selected.today {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.4);
}

.calendar-day:active:not(.empty) {
  transform: scale(0.95);
}

.calendar-day-number {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 500;
}

/* 内联时间选择器 */
.inline-time-picker {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
}

.inline-time-picker.expanded {
  max-height: 350px;
  padding-bottom: 16px;
  overflow-y: visible;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  padding-top: 8px;
  margin-bottom: 16px;
}

.time-picker-wrapper {
  width: 100%;
  position: relative;
  padding: 8px;
  box-sizing: border-box;
}

.time-picker-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.time-picker-container::before {
  display: none;
}

.time-picker-view {
  width: 100%;
  height: 120px;
  position: relative;
  display: flex;
  flex-direction: row;
  justify-content:center;
}

.time-picker-column {
  flex: 1;
  position: relative;
  height: 100%;
  padding:0;
  margin:0;
}

.time-picker-item {
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 40px;
}

.time-picker-text {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.9);
  transition: all 0.2s;
}

/* 固定底部按钮 */
.sure-button-fixed {
  position: fixed;
  bottom: 36px; /* 与底部导航栏位置一致 (30px + 60px) */
  left: 16px;
  right: 16px;
  height: 56px;
  background-color: #A2E525;
  border-radius: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: opacity 0.2s;
  z-index: 99;
}

.sure-button-fixed:active {
  opacity: 0.8;
}

.sure-button-text {
  font-size: 20px;
  color: #000;
  font-weight: 700;
}

/* 我的日程标签页样式 */
.schedule-content {
  width: 100%;
  height: calc(100vh - 158px);
}

.schedule-list {
  width: 100%;
  height: 100%;
  padding: 16px;
}

.schedule-card {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.schedule-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.schedule-card-title {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.schedule-card-footer {
  display: flex;
  align-items: center;
  gap: 16px;
}

.schedule-card-date {
  font-size: 14px;
  color: #FFFFFF;
  opacity: 0.7;
}

.schedule-card-time {
  font-size: 14px;
  color: #FFFFFF;
  opacity: 0.7;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 20px;
  min-height: 200px;
}

.empty-text {
  font-size: 16px;
  color: #8E8E93;
  text-align: center;
}

/* 年份选择器弹窗 */
.year-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.year-picker-content {
  width: 80%;
  max-width: 400px;
  background-color: #2C3A4A;
  border-radius: 16px;
  padding: 20px;
  box-sizing: border-box;
}

.year-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.year-picker-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.year-picker-close {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #FFFFFF;
  cursor: pointer;
}

.year-picker-container {
  height: 200px;
  margin-bottom: 20px;
}

.year-picker-view {
  width: 100%;
  height: 200px;
}

.year-picker-item {
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 40px;
}

.year-picker-text {
  font-size: 18px;
  color: #8E8E93;
  transition: all 0.2s;
}

.year-picker-footer {
  display: flex;
  justify-content: center;
}

.year-picker-confirm-btn {
  width: 100%;
  height: 44px;
  background-color: #A2E525;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #000;
  font-weight: 600;
  border: none;
  cursor: pointer;
}

.year-picker-confirm-btn:active {
  opacity: 0.8;
}
