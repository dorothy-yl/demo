<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="onBack">
      <image class="back-icon" src="/app/images/icons/Vector.svg" />
      <text class="back-text">返回</text>
    </view>
    <text class="page-title">重复</text>
    <view class="placeholder"></view>
  </view>

  <view class="days-list">
    <view class="day-item" ty:for="{{days}}" ty:key="id" bindtap="toggleDay" data-id="{{item.id}}">
      <text class="day-name">{{item.name}}</text>
      <view class="check-mark" ty:if="{{item.selected}}">✓</view>
    </view>
  </view>
</view>

