.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg,#000 0%,#000 100%);
  padding: 0;
  padding-bottom: 80px;
  box-sizing: border-box;
  position: fixed;
  top:0;
  left:0;
  right:0;
}

body {
  margin: 0;
  padding: 0;
  background-color: #000; 
}

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15px 10px;
  background-color:#000000; 
  margin-top:75px;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 4px;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
  filter: brightness(0) saturate(100%) invert(58%) sepia(100%) saturate(2000%) hue-rotate(0deg) brightness(1.1) contrast(1);
}

.back-text {
  font-size: 16px;
  color: #FFA500;
  left:20px;
}

.page-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  color: #ffffff; 

}

.placeholder {
  width: 60px;
}

.days-list {
  background-color: rgba(255, 255, 255, 0.05);
  margin-top: 20px;
  border-radius: 10px;
  margin-left: 16px;
  margin-right: 16px;
}

.day-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.day-item:last-child {
  border-bottom: none;
}

.day-name {
  font-size: 16px;
  color: #ffffff; 
}

.check-mark {
  color: #FFA500;
  font-size: 18px;
  font-weight: bold;
}

