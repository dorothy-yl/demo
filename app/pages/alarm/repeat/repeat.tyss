.container {
  background-color: #000;
  min-height: 100vh;
  color: #fff;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 10px;
  background-color:#000000; /* Match Add page */
  position: relative;
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.page-title {
  font-size: 18px;
  font-weight: bold;
}

.placeholder {
  width: 60px;
}

.days-list {
  background-color: #1A1D35;
  margin-top: 20px;
  border-radius: 10px;
  margin-left: 16px;
  margin-right: 16px;
}

.day-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.day-item:last-child {
  border-bottom: none;
}

.day-name {
  font-size: 16px;
}

.check-mark {
  color: #FFA500;
  font-size: 18px;
  font-weight: bold;
}

