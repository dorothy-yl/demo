.container {
  width: 100%;
  min-height: 100vh;
  background-color: #2C3A4A;
  padding: 0;
  padding-bottom: 100px;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15px 10px;
  background-color: #2C3A4A; 
  position: relative;
}

.back-btn {
  position: absolute;
  left: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 4px;
  z-index: 10;
}

.back-icon {
  width: 9px;
  height: 18px;
  left: 16px;
  filter: brightness(0) saturate(100%) invert(58%) sepia(100%) saturate(2000%) hue-rotate(0deg) brightness(1.1) contrast(1);
}

.back-text {
  font-size: 16px;
  color: #FFA500;
}

.page-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  color: #ffffff;
}

.placeholder {
  width: 60px; /* Match back-btn width for symmetry */
}

/* Month Header */
.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 16px;
  margin-top: 10px;
}

.month-nav-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
}

.nav-arrow {
  font-size: 24px;
  color: #FFA500;
  font-weight: bold;
}

.month-title {
  font-size: 20px;
  font-weight: 600;
  color: #FFFFFF;
}

/* Weekday Headers */
.weekday-headers {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 0 16px;
  margin-bottom: 10px;
}

.weekday-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 0;
}

.weekday-text {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 500;
}

/* Calendar Grid - Responsive */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  padding: 0 16px;
  width: 100%;
  box-sizing: border-box;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.05);
  position: relative;
  min-height: 44px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.calendar-day.other-month {
  opacity: 0.3;
}

.calendar-day.today {
  background-color: rgba(82, 196, 26, 0.2);
  border: 1px solid #52C41A;
}

.calendar-day.has-settings {
  background-color: rgba(82, 196, 26, 0.15);
}

.calendar-day.has-settings.today {
  background-color: rgba(82, 196, 26, 0.3);
}

.calendar-day.selected {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.25);
}

.calendar-day.selected.today {
  border: 2px solid #52C41A;
  background-color: rgba(82, 196, 26, 0.35);
}

.day-number {
  font-size: 16px;
  color: #FFFFFF;
  font-weight: 500;
}

.settings-indicator {
  position: absolute;
  bottom: 4px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #52C41A;
}

/* Responsive adjustments */
@media (max-width: 375px) {
  .calendar-day {
    min-height: 40px;
  }
  
  .day-number {
    font-size: 14px;
  }
  
  .month-title {
    font-size: 18px;
  }
}

@media (min-width: 768px) {
  .calendar-grid {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .month-header {
    max-width: 600px;
    margin: 10px auto 0;
  }
  
  .weekday-headers {
    max-width: 600px;
    margin: 0 auto;
  }
}

