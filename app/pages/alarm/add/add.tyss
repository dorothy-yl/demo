.container {
  width: 100%;
  background-color: #000000;
  min-height: 100vh;
  color: #fff;
  display: flex;
  flex-direction: column;
}

.header-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background-color: #000000;
}

.page-title {
  font-size: 17px;
  font-weight: 600;
  color: #FFFFFF;
}

.action-btn {
  font-size: 17px;
}

.action-btn.cancel {
  color: #FF9F0A;
}

.action-btn.save {
  color: #FF9F0A;
  font-weight: 600;
}

.picker-container {
  margin-top: 20px;
  margin-bottom: 30px;
  display: flex;
  justify-content: center;
}

/* Picker styles */
.time-picker {
  width: 100%;
  height: 240px;
  background-color: #000000;
}

.picker-column {
  line-height: 50px;
  text-align: center;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.picker-item {
  line-height: 50px;
  text-align: center;
}

.settings-list {
  background-color: #1C1C1E;
  border-radius: 10px;
  margin: 0 16px;
  overflow: hidden;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 0.5px solid rgba(84, 84, 88, 0.65); /* Separator line */
}

.settings-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 17px;
  color: #FFFFFF;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 17px;
  color: #8E8E93;
  margin-right: 8px;
}

.arrow {
  color: #8E8E93;
  font-size: 17px;
  font-family: monospace; /* Or use an icon font */
  opacity: 0.5;
}


