<view class="container">
  <view class="header-actions">
    <text class="action-btn cancel" bindtap="onCancel">取消</text>
    <text class="page-title">添加闹钟</text>
    <text class="action-btn save" bindtap="onSave">存储</text>
  </view>

  <view class="picker-container">
    <picker-view 
      class="time-picker" 
      indicator-style="height: 50px; background-color: rgba(255, 255, 255, 0.1); border-radius: 8px;" 
      mask-style="background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), rgba(0,0,0,0)), linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));"
      value="{{value}}" 
      bindchange="bindChange"
    >
      <picker-view-column class="picker-column">
        <view ty:for="{{hours}}" ty:key="*this" class="picker-item">{{item}}</view>
      </picker-view-column>
      <picker-view-column class="picker-column">
        <view ty:for="{{minutes}}" ty:key="*this" class="picker-item">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>

  <view class="settings-list">
    <view class="settings-item" bindtap="goToRepeat">
      <text class="item-label">重复</text>
      <view class="item-right">
        <text class="item-value">{{repeatText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>

