<view class="container">
  <view class="header-actions">
    <text class="action-btn cancel" bindtap="onCancel">取消</text>
    <text class="page-title">添加闹钟</text>
    <text class="action-btn save" bindtap="onSave">存储</text>
  </view>

  <view class="picker-container">
    <picker-view indicator-style="height: 50px;" style="width: 100%; height: 300px;" value="{{value}}" bindchange="bindChange">
      <picker-view-column>
        <view ty:for="{{hours}}" ty:key="*this" style="line-height: 50px; text-align: center; color: white;">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view ty:for="{{minutes}}" ty:key="*this" style="line-height: 50px; text-align: center; color: white;">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>

  <view class="settings-list">
    <view class="settings-item" bindtap="goToRepeat">
      <text class="item-label">重复</text>
      <view class="item-right">
        <text class="item-value">{{repeatText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <!-- Add Label if needed later -->
    <!-- <view class="settings-item">
      <text class="item-label">标签</text>
      <view class="item-right">
        <text class="item-value">闹钟</text>
        <text class="arrow">›</text>
      </view>
    </view> -->
  </view>
</view>

