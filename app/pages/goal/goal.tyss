.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  object-fit: cover;
  filter: none;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background-color: #2C3A4A;
  opacity: 0.7;
}

/* Custom Nav */
.custom-nav {
  width: 100%;
  z-index: 10;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center; /* Center title */
  position: relative;
  padding: 0 16px;
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 20px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.nav-title {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 600;
  margin-top: 53px;
  }

.content {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}

.goal-buttons {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.goal-btn {
  width: 329px;
  height: 75px;
  border-radius: 11px;
  font-size: 28px;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.goal-btn.primary {
  background-color: #C1E734; /* Green color when selected */
  color: #000000;
  backdrop-filter: blur(10px);
}

.goal-btn.secondary {
  background-color: rgba(255, 255, 255, 0.2); /* Transparent white */
  color: #FFFFFF;
  backdrop-filter: blur(10px);
}

/* Picker Styles */
.picker-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0px 15px;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.picker-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20px;
}

.picker-title {
  width:130px;
  height:28px;
  font-size: 20px;
  color: #FFFFFF;
  margin-top:60px;
}

.picker-display {
  font-size: 64px;
  font-weight: bold;
  color: #FFFFFF;
  font-family: 'DIN Condensed', 'Oswald', sans-serif-condensed, sans-serif;
}

.time-picker {
  width: 330px;
  height: 100px;
  margin-top:50px;

}

.picker-indicator {
  height: 50px;
  background-color: rgba(150, 61, 61, 0.7);
  border:none;
  border-radius: 6px;
  position: relative;
  z-index: 100
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-item {
  text-align: center;
   color:rgba(255, 255, 255, 0.9);
  font-size: 24px;
  background-color: transparent; 
  position: relative;
  z-index: 0;
}

.picker-item.picker-selected {
  position: relative;
  opacity: 0; 
}

.unit {
  font-size: 20px;
  margin-left: 4px;
  color: #FFFFFF;
}

.sure-btn {
  width: 100%;
  height: 56px;
  background-color: #C1E734;
  border-radius: 30px;
  color: #000000;
  font-size: 20px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40px;
  margin-top: auto; /* Push to bottom */
}

/* Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 329px;
  background-color: rgba(44, 58, 74, 0.9);
  border-radius: 11px;
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.modal-picker-container {
  width: 250px;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30px;
  gap: 20px;
}

/* Blue Box for Title */
.modal-title-box {
  width: 100%;
  min-height: 50px;
  border: 2px solid #4A90E2;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 20px;
  box-sizing: border-box;
  background-color: rgba(74, 144, 226, 0.1);
}

.modal-title-text {
  font-size: 20px;
  color: #FFFFFF;
  font-weight: 500;
}

/* Red Box for Picker */
.modal-picker-box {
  width: 100%;
  height: 300px; /* 5 items × 60px = 300px */
  border-radius: 8px;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-picker {
  width: 100%;
  height: 300px; /* 严格限制为5个数字的高度 */
  background: transparent;
  overflow: hidden;
}

.modal-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60px;
  line-height: 60px;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.modal-picker-item.active {
  font-size: 36px;
  color: #FFFFFF;
  font-weight: bold;
}

.modal-unit {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24px;
  color: rgba(255, 255, 255, 0.7);
  pointer-events: none;
  z-index: 10;
}

.modal-confirm-btn {
  width: 100%;
  height: 56px;
  background-color: #C1E734;
  border-radius: 30px;
  color: #000000;
  font-size: 20px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
