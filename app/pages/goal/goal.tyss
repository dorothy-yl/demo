.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  object-fit: cover;
  filter: none;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background-color: #2C3A4A;
  opacity: 0.7;
}

/* Custom Nav */
.custom-nav {
  width: 100%;
  z-index: 10;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center; /* Center title */
  position: relative;
  padding: 0 16px;
}

.back-btn {
  width: 30px; /* Increased touch area */
  height: 30px;
  position: absolute;
  margin-top: 53px;
  left: 20px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 10; /* Ensure above title if overlap */
}

.back-icon {
  width: 9px;
  height: 18px;
}

.nav-title {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 600;
  margin-top: 53px;
  }

.content {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}

.goal-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.goal-btn {
  width: 329px;
  height: 75px;
  border-radius: 11px;
  font-size: 28px;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.goal-btn.primary {
  background-color: #C1E734; /* Light green from screenshot */
  color: #000000;
}

.goal-btn.secondary {
  background-color: rgba(255, 255, 255, 0.2); /* Transparent white */
  color: #FFFFFF;
  backdrop-filter: blur(10px);
}

/* Picker Styles */
.picker-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 20px;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.picker-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20px;
}

.picker-title {
  width:130px;
  height:28px;
  font-size: 20px;
  color: #FFFFFF;
  margin-top:20px;
}

.picker-display {
  font-size: 64px;
  font-weight: bold;
  color: #FFFFFF;
  font-family: 'DIN Condensed', 'Oswald', sans-serif-condensed, sans-serif;
  margin-bottom: 20px;
}

.time-picker {
  width: 330px;
  height: 180px;
  margin: 0;
  color: #FFFFFF;
  margin-top:20px;

}

.picker-indicator {
  height: 50px;
  background-color: rgba(255, 255, 255, 0.1); 
  border:none;
  border-radius: 6px;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-item {
  text-align: center;
  color:rgba(255, 255, 255, 0.9);
  font-size: 24px;
  background-color: transparent; 
  position: relative;
  z-index: 0;
}

.picker-item.picker-selected {
  position: relative;
  opacity: 0; 
}

.unit {
  font-size: 20px;
  margin-left: 4px;
  color: #FFFFFF;
}

.sure-btn {
  width: 100%;
  height: 56px;
  background-color: #C1E734;
  border-radius: 30px;
  color: #000000;
  font-size: 20px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40px;
  margin-top: auto; /* Push to bottom */
}
